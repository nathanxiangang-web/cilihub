CILIHUB_PORT=18792
OPENLIST_ORIGIN=https://openlist.example.com
OPENLIST_FOLDER=/影视
OPENLIST_CDN_HOST=cdnfhnfile.115cdn.net
OPENLIST_CREDENTIALS_PATH=./private/openlist.json

# PostgreSQL 连接串（compose 中的 db 服务已内置，保持默认即可）
CILIHUB_DATABASE_URL=postgres://cilihub:cilihub@db:5432/cilihub?sslmode=disable

# 管理后台（/admin）首次启动时创建的管理员账号。
CILIHUB_ADMIN_USER=admin
# 留空则随机生成 16 位密码，并打印到容器日志（docker compose logs web）。
CILIHUB_ADMIN_PASSWORD=